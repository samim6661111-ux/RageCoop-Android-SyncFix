+        private static Vehicle ResolveVehicleForPedSync(Ped ped, byte speed)
+        {
+            Vehicle vehicle = speed == 5 ? ped.VehicleTryingToEnter : ped.CurrentVehicle;
+            if (vehicle == null || !vehicle.Exists())
+                vehicle = ped.CurrentVehicle;
+            if ((vehicle == null || !vehicle.Exists()) && speed == 6)
+                vehicle = ped.LastVehicle;
+            if ((vehicle == null || !vehicle.Exists()) && speed == 5)
+                vehicle = ped.VehicleTryingToEnter;
+
+            if (vehicle != null && vehicle.Exists())
+                return vehicle;
+
+            // Some Android SHVDN builds can return null from the managed vehicle properties
+            // while the native ped state still has a valid vehicle handle. Resolve that handle
+            // directly before giving up on the vehicle sync frame.
+            int handle = 0;
+            if (speed == 5)
+                handle = Function.Call<int>((Hash)0x814FA8BE5449445D, ped.Handle); // GET_VEHICLE_PED_IS_TRYING_TO_ENTER
+            if (handle == 0)
+                handle = Function.Call<int>((Hash)0x9A9112A0FE9A4713, ped.Handle, speed == 6); // GET_VEHICLE_PED_IS_IN
+
+            if (handle == 0)
+                return null;
+
+            vehicle = Entity.FromHandle(handle) as Vehicle;
+            return vehicle != null && vehicle.Exists() ? vehicle : null;
+        }
